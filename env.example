# Copy this file to .env and fill in real values on the server.
# Never commit .env. Keep real secrets out of this repository.

# --- Application ---
APP_ENV=development
APP_BASE_URL=https://example.com
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=classroom
DB_USER=change-me
DB_PASSWORD=change-me

# --- Mail ---
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Classroom Notice

# --- AWS ---
AWS_REGION=ap-northeast-1
BACKUP_BUCKET_NAME=change-me
